actions: 
  - action: delete_indices
    description: delete selected indices5
    options: 
      disable_action: false
      delay: 5
    filters:
    - filtertype: age
      source: creation_date
      direction: older
      unit: days
      unit_count: 1
    - filtertype: pattern
      kind: prefix
      value: logstash-zs
      exclude: 
    - filtertype: space
      disk_space: 0.1
      use_age: True
      source: creation_date


